.DS_Store
__pycache__/

# wrangler pages dev local state (deploy.sh already rsync-excludes it)
.wrangler/

# The pre-deploy checks each render a scratch page beside the real ones --
# _vqa, _nojs, _console, _perf, __code_overflow_probe -- and deploy.sh runs
# them every time, so they reappeared in `git status` after every deploy.
# Build scratch, not source; qa.py already skips anything starting with an
# underscore, and deploy.sh rsync-excludes them.
_*.html
__*.html
