.DS_Store
__pycache__/

# wrangler pages dev local state (deploy.sh already rsync-excludes it)
.wrangler/

# visual_qa.py writes these two scratch files next to the pages it renders and
# deploy.sh runs it on every deploy, so they reappear in `git status` every
# time. They are build scratch, not source; qa.py already skips anything
# starting with an underscore.
_vqa.html
_vqa_frame.html
