/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN

# A day, not a week. These filenames carry no content hash, and this account's
# deploy token cannot purge cache — so a week-long TTL means a week of stale
# branding after any asset change. Bump the ?v= query when one changes.
/assets/og-cover.png
  Cache-Control: public, max-age=86400

/assets/favicon.svg
  Cache-Control: public, max-age=86400

/assets/logo.svg
  Cache-Control: public, max-age=86400
