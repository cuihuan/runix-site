/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  X-Frame-Options: SAMEORIGIN

# Images and the logo change rarely and are safe to hold on to.
# The stylesheet deliberately is not here: its filename carries no hash, so a
# long browser cache would strand visitors on an old design after a deploy.
/assets/og-cover.png
  Cache-Control: public, max-age=604800

/assets/favicon.svg
  Cache-Control: public, max-age=604800

/assets/logo.svg
  Cache-Control: public, max-age=604800
